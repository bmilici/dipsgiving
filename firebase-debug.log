[debug] [2026-05-06T13:24:35.446Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/dipsgiving/rulesets {"name":"projects/dipsgiving/rulesets/90ef7d67-b8ff-49f1-bcf2-44bc7ffd05ab","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isOwnVoteDoc(voteId) {\n      return signedIn() && voteId.matches(request.auth.uid + \"_[0-9]{4}\");\n    }\n\n    function validVoteDoc() {\n      return request.resource.data.keys().hasOnly([\n          \"uid\",\n          \"year\",\n          \"dipIds\",\n          \"updated_at\"\n        ])\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.year is int\n        && request.resource.data.dipIds is list\n        && request.resource.data.dipIds.size() <= 3;\n    }\n\n    function validVoteCreate() {\n      return validVoteDoc()\n        && request.resource.data.dipIds.size() == 1;\n    }\n\n    function validVoteUpdate() {\n      return validVoteDoc()\n        && resource.data.uid == request.auth.uid\n        && request.resource.data.year == resource.data.year\n        && (\n          request.resource.data.dipIds.size() == resource.data.dipIds.size() + 1\n          || request.resource.data.dipIds.size() == resource.data.dipIds.size() - 1\n        );\n    }\n\n    function validRegistrationCreate() {\n      return request.resource.data.keys().hasAll([\"name\", \"event\", \"created_at\"])\n        && request.resource.data.name is string\n        && request.resource.data.event is string;\n    }\n\n    function validVoteChange() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"votes\"])\n        && request.resource.data.votes is int\n        && (\n          (\n            resource.data.keys().hasAny([\"votes\"])\n            && resource.data.votes is int\n            && request.resource.data.votes == resource.data.votes + 1\n          )\n          || (\n            !resource.data.keys().hasAny([\"votes\"])\n            && request.resource.data.votes == 1\n          )\n          || (\n            resource.data.keys().hasAny([\"votes\"])\n            && resource.data.votes is int\n            && resource.data.votes > 0\n            && request.resource.data.votes == resource.data.votes - 1\n          )\n        );\n    }\n\n    match /registrations/{registrationId} {\n      allow read: if true;\n      allow create: if validRegistrationCreate();\n      allow update: if signedIn() && validVoteChange();\n      allow delete: if false;\n    }\n\n    match /userVotes/{voteId} {\n      allow get: if isOwnVoteDoc(voteId);\n      allow list: if false;\n      allow create: if isOwnVoteDoc(voteId) && validVoteCreate();\n      allow update: if isOwnVoteDoc(voteId) && validVoteUpdate();\n      allow delete: if false;\n    }\n\n    match /dips/{dipId} {\n      allow read: if true;\n      allow create: if signedIn()\n        && request.resource.data.keys().hasAll([\"name\", \"dip\", \"year\", \"createdAt\"]);\n      allow update, delete: if false;\n    }\n\n    match /winners/{winnerId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    match /invitationList/{inviteeId} {\n      allow read: if signedIn();\n      allow create, update: if signedIn()\n        && request.resource.data.keys().hasOnly([\n          \"name\",\n          \"phone\",\n          \"notes\",\n          \"invite_next_year\",\n          \"last_party_size\",\n          \"source_year\",\n          \"source_registration_ids\",\n          \"created_at\",\n          \"updated_at\"\n        ])\n        && request.resource.data.name is string\n        && request.resource.data.phone is string\n        && request.resource.data.notes is string\n        && request.resource.data.invite_next_year is bool;\n      allow delete: if signedIn();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-06T13:24:35.502303Z","metadata":{"services":["cloud.firestore"]}}
