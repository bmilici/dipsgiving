{
  "name": "dipsgiving",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "dev:rsvp-lookup": "DIPSGIVING_RSVP_LOOKUP_TESTING=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8188 next dev --hostname 127.0.0.1 --port 3018",
    "build:rsvp-lookup": "DIPSGIVING_RSVP_LOOKUP_TESTING=true NEXT_PUBLIC_DESIGN_PREVIEW=true next build --turbopack",
    "start:rsvp-lookup": "DIPSGIVING_RSVP_LOOKUP_TESTING=true NEXT_PUBLIC_DESIGN_PREVIEW=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8188 next start --hostname 127.0.0.1 --port 3018",
    "emulators:rsvp": "npx --yes firebase-tools@15.34.1 emulators:start --only firestore --project demo-dipsgiving-rsvp-test --config firebase.rsvp-testing.json"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.76.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "firebase-admin": "^14.5.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.546.0",
    "next": "15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
